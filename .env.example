# PayPal Sandbox Credentials (DO NOT COMMIT REAL SECRETS)
# Mode must be 'sandbox'
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# Sandbox Test Accounts (Personal accounts for verification)
# Legitimate vendor sandbox personal email:
PAYPAL_VENDOR_EMAIL=vendor-sandbox@example.test
# Attacker sandbox personal email (used only in adversarial tests, NEVER in Gate 1):
PAYPAL_ATTACKER_EMAIL=attacker-sandbox@example.test

# AI Model Configuration (Optional for Gate 1, required for Phase 2 intake)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
APP_ENV=development
SECRET_KEY=change_this_to_a_random_secret_in_development
